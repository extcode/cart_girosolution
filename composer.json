{
    "name": "extcode/cart-girosolution",
    "type": "typo3-cms-extension",
    "description": "Shopping Cart(s) for TYPO3 - Girosolution Payment Provider",
    "homepage": "https://cart.extco.de",
    "license": [
        "GPL-2.0-or-later"
    ],
    "keywords": [
        "TYPO3 CMS",
        "Shopping Cart",
        "Payment Provider",
        "Girosolution",
        "Cart"
    ],
    "authors": [
        {
            "name": "Daniel Gohlke",
            "email": "ext@extco.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/extcode/cart_girosolution/issues"
    },
    "autoload": {
        "psr-4": {
            "Extcode\\CartGirosolution\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Extcode\\CartGirosolution\\Tests\\": "Tests/"
        }
    },
    "config": {
        "bin-dir": ".Build/bin",
        "vendor-dir": ".Build/vendor",
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        },
        "lock": false
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "cart_girosolution",
            "web-dir": ".Build/public"
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "extcode/cart": "^11.0",
        "girosolution/girocheckout-sdk": "^2.6",
        "typo3/cms-core": "^13.4",
        "typo3/cms-extbase": "^13.4",
        "typo3/cms-fluid": "^13.4"
    },
    "require-dev": {
        "codappix/typo3-php-datasets": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64",
        "helmich/typo3-typoscript-lint": "^3.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpcov": "^10.0 || ^11.0 || ^12.0",
        "ssch/typo3-rector": "^3.13",
        "typo3/testing-framework": "^9.5"
    },
    "scripts": {
        "project:cgl": "Build/Scripts/cgl.sh",
        "project:cgl:fix": "Build/Scripts/cgl.sh --fix",
        "project:lint": [
            "@project:lint:php",
            "@project:lint:typoscript",
            "@project:lint:xml",
            "@project:lint:yaml"
        ],
        "project:lint:php": "Build/Scripts/lint-php.sh",
        "project:lint:typoscript": "Build/Scripts/lint-typoscript.sh",
        "project:lint:xml": "Build/Scripts/lint-xml.sh",
        "project:lint:yaml": "Build/Scripts/lint-yaml.sh",
        "project:phpstan": "Build/Scripts/phpstan.sh",
        "project:test:unit": "Build/Scripts/phpunit.sh unit",
        "project:test:functional": "Build/Scripts/phpunit.sh functional",
        "project:test:coverage": "Build/Scripts/coverage.sh"
    }
}
