{
    "name": "extcode/cart-girosolution",
    "type": "typo3-cms-extension",
    "description": "Shopping Cart(s) for TYPO3 - Girosolution Payment Provider",
    "homepage": "https://cart.extco.de",
    "license": [
        "GPL-2.0+"
    ],
    "keywords": [
        "TYPO3 CMS",
        "Shopping Cart",
        "Payment Provider",
        "Girosolution",
        "Cart"
    ],
    "authors": [
        {
            "name": "Daniel Gohlke",
            "email": "ext@extco.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/extcode/cart_girosolution/issues"
    },
    "autoload": {
        "psr-4": {
            "Extcode\\CartGirosolution\\": "Classes"
        }
    },
    "config": {
        "bin-dir": ".Build/bin",
        "vendor-dir": ".Build/vendor",
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        },
        "lock": false
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "cart_girosolution",
            "web-dir": ".Build/public"
        }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "extcode/cart": "^12.0",
        "girosolution/girocheckout-sdk": "^2.6",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "helmich/typo3-typoscript-lint": "^3.1",
        "phpstan/phpstan": "^2.1",
        "ssch/typo3-rector": "^3.13"
    },
    "scripts": {
        "project:cgl": "Build/Scripts/cgl.sh",
        "project:cgl:fix": "Build/Scripts/cgl.sh --fix",
        "project:lint": [
            "@project:lint:php"
        ],
        "project:lint:php": "Build/Scripts/lint-php.sh",
        "project:phpstan": "Build/Scripts/phpstan.sh"
    }
}
